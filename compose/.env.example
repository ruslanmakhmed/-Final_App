# Скопируйте в .env и заполните (scripts/bootstrap.sh делает это сам).
# .env в git не попадает.

# Реестр и тег образа. Тег = тег git (v0.1.0) или короткий хеш коммита, никогда не latest.
REGISTRY=
IMAGE_TAG=

# База данных
DB_NAME=
DB_USER=
DB_PASSWORD=

# Приложение
APP_PORT=
LOG_LEVEL=

# Порт на хосте
HOST_PORT=
